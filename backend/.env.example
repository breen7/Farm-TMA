# --- App ---
PORT=3000
NODE_ENV=development

# --- Telegram ---
BOT_TOKEN=123456:ABC-DEF_your_bot_token_here

# --- Database ---
# Con Docker local (docker-compose.yml) ambas son iguales. Con un provider
# pooled (ej. Supabase) DATABASE_URL debe ser la conexion via pooler
# (puerto 6543, con ?pgbouncer=true) y DIRECT_URL la conexion directa
# (puerto 5432) — Prisma Migrate necesita la directa, sin pooler de por medio.
DATABASE_URL=postgresql://farm:farm@localhost:5432/farm_tma?schema=public
DIRECT_URL=postgresql://farm:farm@localhost:5432/farm_tma?schema=public

# --- Redis / BullMQ ---
# Si REDIS_URL esta seteada, tiene prioridad sobre HOST/PORT/PASSWORD y se usa
# tal cual (soporta rediss:// para TLS, como el que da Upstash gratis).
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Admin (backoffice interno, no el Mini App) ---
ADMIN_API_SECRET=change-me

# --- Ad Networks ---
ADSGRAM_WEBHOOK_SECRET=change-me
MONETAG_WEBHOOK_SECRET=change-me
# eCPM simulado (USD) para POST /ads/simulate, deshabilitado si NODE_ENV=production.
AD_SIMULATOR_ECPM_USD=5

# --- Economia (ver seccion 1 del diseno) ---
BUCKS_PER_USD=1000
DEFAULT_ALPHA=0.65
DEFAULT_BETA=0.90

# --- Farm / Boosts ---
BOOST_MULTIPLIER=2
BOOST_DURATION_HOURS=2
BOOST_COST_BUCKS=50

# --- Mejora de silo (Coins, nunca Bucks — ver comentario en FarmService.sell) ---
# Capacidad que suma cada mejora, costo base de la primera, y multiplicador
# de costo por cada mejora sucesiva (curva de crecimiento del sink).
STORAGE_UPGRADE_AMOUNT=500
STORAGE_UPGRADE_BASE_COST_COINS=200
STORAGE_UPGRADE_COST_MULTIPLIER=1.5

# --- Depositos (dinero real entrando, via TonConnect) ---
# Precio del boost pagado con deposito TON real (alternativa a BOOST_COST_BUCKS).
BOOST_COST_TON=0.02
# Minutos que una intencion de deposito queda PENDING antes de expirar.
DEPOSIT_EXPIRY_MINUTES=30
# Cada cuanto corre el sweep que revisa depositos PENDING (backstop; el
# camino principal es el polling del frontend en GET /deposits/:id).
DEPOSIT_SWEEP_INTERVAL_MINUTES=2

# --- TON ---
TON_RPC_ENDPOINT=https://toncenter.com/api/v2/jsonRPC
TON_RPC_API_KEY=change-me
TON_HOT_WALLET_MNEMONIC="word1 word2 ... word24"
USDT_JETTON_MASTER_ADDRESS=EQ...
# Tasa TON/USD manual: no hay oraculo de precio integrado todavia, se debe
# actualizar a mano (u operativamente via un job futuro) antes de habilitar
# retiros en TON nativo. Los retiros en USDT no la necesitan (1:1 con USD).
TON_USD_RATE=
WITHDRAWAL_AUTO_APPROVE_USD_LIMIT=10
WITHDRAWAL_AUTO_APPROVE_MAX_RISK_SCORE=50
WITHDRAWAL_MIN_USD=1

# --- Reconciliacion de retiros atascados ---
# Cada cuanto corre el sweep, y a partir de cuantos minutos en PROCESSING
# se considera un retiro "atascado" (candidato a verificar/reembolsar).
RECONCILE_SWEEP_INTERVAL_MINUTES=5
RECONCILE_STUCK_PROCESSING_MINUTES=15
