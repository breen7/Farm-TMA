# URL base del backend NestJS
VITE_API_URL=http://localhost:3000

# URL publica (HTTPS) del tonconnect-manifest.json. Los wallets deben poder
# alcanzarla, por lo que no funciona apuntando a localhost salvo con un tunel
# (ngrok/cloudflared). En produccion, la del dominio donde se sirva la app.
VITE_TONCONNECT_MANIFEST_URL=

# Username del bot (sin @) y short name de la Mini App configurado en
# BotFather, para armar el link de invitacion
# (https://t.me/<bot>/<app>?startapp=ref_<id>). Sin esto, la tarjeta de
# referidos no genera link.
VITE_BOT_USERNAME=
VITE_MINI_APP_SHORT_NAME=

# Block ID de Adsgram (Settings > Platforms > tu Ad Unit > "Show code" en su
# dashboard). Sin esto, el boton de anuncios cae al simulador local (que a su
# vez esta deshabilitado en produccion, NODE_ENV=production) - ver lib/ads.ts.
VITE_ADSGRAM_BLOCK_ID=

# Solo para desarrollo fuera de Telegram: initData real y firmado, para que
# las requests autenticadas funcionen de verdad en un navegador normal (sin
# esto, el SDK simula un initData con hash invalido y el backend rechaza todo
# con 401). Generalo desde backend/ con:
#   node scripts/generate-test-init-data.js 111111
# y pegá la salida completa aca (necesita el mismo BOT_TOKEN que backend/.env).
# Reiniciar `npm run dev` despues de cambiar esto.
VITE_DEV_INIT_DATA=
